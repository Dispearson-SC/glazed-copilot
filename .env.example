# Copy to .env (`cp .env.example .env`) and fill in the REQUIRED lines. Never commit .env.
# `make up` / `make data` read this file; so does `docker compose --env-file .env`.
# Lines marked "dev only" are for running the backend on the host (`make api`), not for Docker.

# ---------------------------------------------------------------------------------------------
# Secrets (REQUIRED unless noted)
# ---------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me            # superuser password of the compose Postgres; change it
MINIMAX_API_KEY=                       # REQUIRED: LLM (Agent-Core), voice STT/TTS and the intent classifier
BACKBOARD_API_KEY=                     # optional: per-store experience memory; empty disables it (recall degrades to [])
GLAZED_SESSION_SECRET=                 # REQUIRED when GLAZED_AUTH_REQUIRED=true: signs session cookies (openssl rand -hex 32)

# ---------------------------------------------------------------------------------------------
# Public host and reverse proxy (Traefik)
# ---------------------------------------------------------------------------------------------
GLAZED_PUBLIC_HOST=glazed.localhost    # DNS name the web is served on (Traefik Host rule)
TRAEFIK_NETWORK=traefik                # name of the existing Docker network Traefik is attached to
TRAEFIK_ENTRYPOINT_HTTP=http           # Traefik entrypoint names (Coolify: http/https; Traefik docs: web/websecure)
TRAEFIK_ENTRYPOINT_HTTPS=https
TRAEFIK_CERTRESOLVER=letsencrypt       # name of the certificate resolver configured in Traefik
GLAZED_WEB_GATE=glazed-web-auth        # glazed-web-auth = basic auth in front of the app; glazed-web-open = no basic auth
# Basic auth entry for glazed-web-auth, "user:apr1-hash". Generate: echo "user:$(openssl passwd -apr1 'password')"
# Inside a compose env file, escape every $ of the hash as $$.
GLAZED_WEB_BASICAUTH=
# No Traefik on this server: use infra/docker-compose.local.yml (`make up LOCAL=1`) and these two:
GLAZED_WEB_PORT=8080                   # host port the web is published on in local mode
GLAZED_BIND_ADDR=127.0.0.1             # interface for the db/backend/core debug ports; 0.0.0.0 exposes them (don't)
GLAZED_BACKEND_PORT=8100               # host port of the backend API
GLAZED_CORE_HOST_PORT=8001             # host port of Agent-Core

# ---------------------------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------------------------
GLAZED_AUTH_REQUIRED=true              # false leaves /api/v1 open
GLAZED_COOKIE_SECURE=true              # true behind HTTPS; false for plain http (local mode)
GLAZED_ADMIN_EMAIL=                    # optional: creates or updates this admin at backend start
GLAZED_ADMIN_PASSWORD=                 # optional: its password (min length enforced by the backend)
GLAZED_DEMO_LOGIN=false                # true shows a passwordless user picker. Demo only, never on a real deployment

# ---------------------------------------------------------------------------------------------
# Order policy and suggestions
# ---------------------------------------------------------------------------------------------
GLAZED_ORDER_POLICY=margin             # margin | waste_aware
GLAZED_WASTE_PENALTY=0                 # waste_aware: extra cost per wasted unit (float)
GLAZED_SERVICE_CAP=                    # optional perishable service-level cap, strictly between 0 and 1 (e.g. 0.97)
GLAZED_PROMO_SUGGESTIONS=true          # false turns off promotions priced from history (activate_promo)

# ---------------------------------------------------------------------------------------------
# Voice (push-to-talk, proxied through the backend so the key never reaches the browser)
# ---------------------------------------------------------------------------------------------
GLAZED_VOICE=true                      # false disables STT/TTS
GLAZED_TTS_VOICE=Spanish_Intonategirl  # MiniMax voice id
GLAZED_TTS_MODEL=speech-2.8-hd
GLAZED_STT_MODEL=asr-1.0
# MINIMAX_API_BASE=https://api.minimax.io/v1                  # override the MiniMax endpoint
# MINIMAX_CLASSIFIER_MODEL=MiniMax-M3.1-flash-preview         # intent classifier fallback model

# ---------------------------------------------------------------------------------------------
# Forecast
# ---------------------------------------------------------------------------------------------
# GLAZED_FORECAST_DIR=../data/forecast/out        # host dir mounted at /forecast (default shown, relative to infra/)
# GLAZED_FORECAST_PATH=/forecast/forecast.parquet # file inside the container; missing file -> weekday baseline
# GLAZED_FORECAST_MODEL=glm_poisson               # which model block of the file to read (default glm_poisson)
# GLAZED_FORECAST_ORIGIN=2026-07-19               # last day of training data (default 2026-07-19)

# ---------------------------------------------------------------------------------------------
# Backend wiring (compose sets these for the containers; change only for host runs or non-default setups)
# ---------------------------------------------------------------------------------------------
# GLAZED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GLAZED_TURN_TIMEOUT_S=600                       # max seconds to wait for an Agent-Core turn
# GLAZED_CORE_PROFILE=glazed_orchestrator         # Core profile id of the orchestrator
# GLAZED_CORE_CHANNEL=glazed
# GLAZED_CORE_ROLES=glazed-manager
# GLAZED_CORE_SERVICE_ROLES=glazed-service
# GLAZED_CORE_SUBJECT=manager-1
# dev only (make api / make load-data / make seed-memory):
# GLAZED_STORAGE=memory                           # memory | postgres (compose uses postgres)
# GLAZED_DATABASE_URL=postgresql://glazed_app:glazed_dev@localhost:55432/glazed_app
# GLAZED_DUCKDB_PATH=../data/clean/glazed.duckdb
# GLAZED_RAW_PATH=../vendor/dataset-road2tech
# GLAZED_PARQUET_DIR=../data/clean                # make load-data source
# GLAZED_CORE_URL=http://localhost:8001           # Agent-Core REST API (host port)

# ---------------------------------------------------------------------------------------------
# Data build and web build
# ---------------------------------------------------------------------------------------------
# DATA_BUILD_MEM=6g                               # memory limit of the `make data` container
# VITE_DEFAULT_SIM_TODAY=2026-07-19               # web build time: date the demo clock opens on

# ---------------------------------------------------------------------------------------------
# CLI (cli/ package, dev only)
# ---------------------------------------------------------------------------------------------
# GLAZED_API_URL=http://localhost:8100
# GLAZED_STATE=                                   # CLI state file path
# GLAZED_FOLLOW_INTERVAL=2
# GLAZED_FOLLOW_POLLS=0
# GLAZED_POLL_INTERVAL=1.0
