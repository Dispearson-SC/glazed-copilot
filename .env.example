# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me
GLAZED_APP_PASSWORD=glazed_dev
# Backend
GLAZED_STORAGE=memory                 # memory | postgres
GLAZED_DATABASE_URL=postgresql://glazed_app:glazed_dev@localhost:55432/glazed_app
GLAZED_DUCKDB_PATH=../Dataset/clean/glazed.duckdb
GLAZED_CORE_URL=http://localhost:8000  # Agent-Core REST API
GLAZED_CORE_PROFILE=glazed_orchestrator  # Core profile id of the orchestrator
# GLAZED_CORE_CHANNEL=glazed GLAZED_CORE_ROLES=glazed-manager GLAZED_CORE_SERVICE_ROLES=glazed-service GLAZED_CORE_SUBJECT=manager-1
# GLAZED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GLAZED_TURN_TIMEOUT_S=600
# Holdout forecast Parquet (job output, origin 2026-07-19). Compose mounts GLAZED_FORECAST_DIR (default ../Dataset/forecast/out if present) at /forecast read-only.
# GLAZED_FORECAST_PATH=/forecast/forecast.parquet GLAZED_FORECAST_ORIGIN=2026-07-19
# CLI/Make: GLAZED_API_URL=http://localhost:8100
# Agent-Core image source: the ROOT of an Agent-Core checkout of branch feat/fast-comms (Core/ and
# addons/), as an absolute path. Unset: ../Agent-Core next to this repository. See docs/agent-core-addons-runbook.md.
# AGENT_CORE_SRC=/abs/path/to/Agent-Core-checkout
# Agent-Core LLM provider is MiniMax
MINIMAX_API_KEY=
# Phase 5: System One (Jev, Typesafe API) turn router. The key is read by the core container at call time.
JEV_API_KEY=
# Routing stays off until this is true (see docs/agent-core-addons-runbook.md, "Phase 5"):
# AGENT_CORE_TURN_ROUTING=false
# Backend follows Core turns over SSE (first-text latency); false -> polling only:
# GLAZED_CORE_STREAM=true
# Backboard per-store experience memory (leave empty to disable; recall then degrades to [])
BACKBOARD_API_KEY=

# Public web basic auth: user:apr1-hash (openssl passwd -apr1)
GLAZED_PUBLIC_HOST=glazed.farone.cloud
GLAZED_WEB_BASICAUTH=
